[Desktop Entry]
Name=AI Voice Assistant - Bandeja del Sistema
Comment=Icono de estado y menú rápido en la bandeja del sistema de KDE Plasma
Exec=nobara-voice-assistant-tray
Icon=audio-input-microphone
Terminal=false
Type=Application
Categories=Utility;AudioVideo;Audio;
StartupNotify=false
X-GNOME-Autostart-enabled=true
X-KDE-autostart-after=panel
